# Paste over the .env that Install.cmd created in D:\HddServer\sites\rop.
# After any later change to .env, run `php artisan optimize` in that folder (config is cached).
APP_NAME="ROP Registry"
APP_ENV=production
# Leave empty: Install.cmd generates it. Keep the line, key:generate only fills an existing one.
APP_KEY=
APP_DEBUG=false
# The address other PCs type, e.g. http://192.168.1.50 (give this PC a fixed IP first)
APP_URL=http://localhost

APP_LOCALE=en
APP_TIMEZONE=Asia/Baghdad
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=5256000
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"

# Copy these from the current PC's .env
ADMIN_NAME="Administrator"
ADMIN_EMAIL=admin@rop.local
ADMIN_PASSWORD=00000000

# Keep backups on another drive than the registry, e.g. E:\ROP-Backups
BACKUP_PATH=
BACKUP_KEEP=30

# Folder the camera software exports into (can also be set on the Camera inbox page)
# CAPTURE_FOLDER=

# Copy the letterhead from the current PC's .env
CLINIC_NAME="المركز التخصصي لطب العيون والليزر"
CLINIC_DOCTOR="الدكتورة واجدة سعد بنيان"
CLINIC_ADDRESS="الناصرية - شارع البريد - مقابل مستشفى الحضارات الاهلي"
CLINIC_PHONE="0781 115 5521"

SHOW_SOURCE_RECORDS=false
