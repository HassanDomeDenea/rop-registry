    { "file": "php", "args": ["artisan", "registry:backup"] }
  ],
  "beforeDeployCommands": [],
  "installCommands": [
    { "file": "php", "args": ["artisan", "db:seed", "--force", "--no-interaction"] }
  ],
  "updateCommands": [],
  "afterDeployCommands": []
}
